{
  "name": "whereabouts-multiplayer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p party && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "countries": "node scripts/build-countries.mjs",
    "party:dev": "wrangler dev --config party/wrangler.jsonc",
    "party:deploy": "wrangler deploy --config party/wrangler.jsonc"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.66.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "mapshaper": "^0.7.87",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
