{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "whereabouts-party",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "PARTY_ROOM", "class_name": "PartyRoom" }]
  },
  // The free plan only supports SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://vic-goncalves.github.io,http://localhost:5173,http://localhost:5199"
  }
}
